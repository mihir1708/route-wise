{
  "name": "route-wise",
  "version": "1.0.0",
  "description": "Intelligent AI model router with budget management",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --incremental false",
