    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "chart.js": "^4.5.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.3",
    "next": "^16.1.3",
    "openai": "^6.16.0",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "tsx": "4.21.0",
    "vitest": "4.0.18"
  }
}
