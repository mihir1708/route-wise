# Provider keys: OpenAI serves the primary models, Anthropic the fallbacks.
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# Budget Settings (optional)
MONTHLY_BUDGET_LIMIT=100
ALERT_THRESHOLD_PERCENT=80

# HTTP Basic auth: use separate random secrets of at least 32 characters.
# Username is demo or admin. HTTPS is required outside localhost.
ROUTEWISE_ADMIN_PASSWORD=
ROUTEWISE_DEMO_PASSWORD=
APP_ORIGIN=http://localhost:3000
# 1 opens the demo page to visitors without the demo password. The demo tenant's own monthly
# budget and rate limits cap what they can spend; admin pages still need the admin password.
ROUTEWISE_PUBLIC_DEMO=0

# Optional runtime registry: JSON array of complete ModelConfig objects.
# Leave empty for the default three-tier OpenAI + Anthropic registry; verify availability before live use.
ROUTEWISE_MODELS_JSON=
# Response cache lifetime in seconds (default 86400); 0 turns the cache off.
ROUTEWISE_CACHE_TTL_S=86400
# Live evaluation and judges are never enabled by default.
ROUTEWISE_LIVE_EVAL=0
ROUTEWISE_JUDGE_MODEL=
ROUTEWISE_MAINTENANCE=0
